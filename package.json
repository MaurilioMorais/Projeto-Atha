{
  "name": "atha",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@angular/common": "^20.0.0", "@angular/compiler": "^20.0.0", "@angular/core": "^20.0.0", "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0", "@angular/router": "^20.0.0", "rxjs": "~7.8.0", "tslib": "^2.6.0", "zone.js": "~0.15.0",
    "express": "^4.21.2", "jsonwebtoken": "^9.0.2", "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0", "@angular/cli": "^20.0.0", "@angular/compiler-cli": "^20.0.0",
    "@tailwindcss/postcss": "^4.1.0", "postcss": "^8.5.0", "tailwindcss": "^4.1.0", "typescript": "~5.8.0", "concurrently": "^9.0.0", "tsx": "^4.19.0",
    "@types/express": "^4.17.21", "@types/jsonwebtoken": "^9.0.7", "@types/node": "^22.0.0"
  }
}
